<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/FrameLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ecran"
    tools:context=".A_UnicaFarma" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <FrameLayout
            android:id="@+id/FrameLayout2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ecran_fundo" >

            <ScrollView
                android:id="@+id/scrollView1"
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="7dp"
                        android:layout_marginRight="7dp"
                        android:layout_weight="1"
                        android:orientation="vertical" >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:layout_marginTop="25dp"
                            android:layout_weight="1"
                            android:visibility="visible" >

                            <ImageView
                                android:id="@+id/imageView25"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_contactos"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_contactos"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="CONTACTOS"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp" >

                            <ImageView
                                android:id="@+id/imageView20"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_enderecos"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_endereco"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="ENDEREÇOS"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp" >

                            <ImageView
                                android:id="@+id/imageView21"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_horarios"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_horarios"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="HORÁRIOS"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp" >

                            <ImageView
                                android:id="@+id/imageView22"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_sobre_nos"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_sobre_nos"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="SOBRE NÓS"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="15dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp" >

                            <ImageView
                                android:id="@+id/imageView23"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_nosso_diferencial"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_diferencial"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="NOSSO DIFERENCIAL"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="25dp"
                            android:layout_marginLeft="18dp"
                            android:layout_marginRight="18dp"
                            android:layout_weight="1" >

                            <ImageView
                                android:id="@+id/imageView24"
                                style="@style/AppBaseTheme"
                                android:layout_width="75dp"
                                android:layout_height="75dp"
                                android:layout_marginRight="18dp"
                                android:background="@drawable/mini_app_assistencia"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/button_assistencia"
                                style="@style/AppBaseTheme"
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_gravity="center"
                                android:background="@drawable/button_interface"
                                android:gravity="center"
                                android:text="APP ASSISTÊNCIA"
                                android:textColor="@color/branca"
                                android:textSize="18dp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/button_voltar_4"
                            android:layout_width="100dp"
                            android:layout_height="50dp"
                            android:layout_gravity="right"
                            android:layout_marginBottom="15dp"
                            android:layout_marginRight="15dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_exit"
                            android:text="Voltar"
                            android:textColor="#ffffff"
                            android:textSize="18dp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

        </FrameLayout>
    </LinearLayout>

</FrameLayout>
